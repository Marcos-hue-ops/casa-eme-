{%- set cap = servicos | categoria('saude-capilar') -%}
{%- set d = destaques.capilar -%}
{#-
  Saúde capilar em destaque: as queixas que a casa trata, pelo nome com que
  as pessoas as procuram. Textos em destaques.js → capilar.

  Na home, a seção "três tempos" (capilar.njk) vem logo em seguida, no mesmo
  fundo, e fecha com o aviso e o botão. `semIntroCapilar` tira o parágrafo de
  abertura quando a página já tem o seu (página de saúde capilar), e
  `rotuloQueixas` troca o sobretítulo numerado da home.
-#}
<section class="queixas" id="queixas-capilares" aria-labelledby="queixas-titulo">
  <div class="env queixas__grade">
    <div class="queixas__cab">
      <p class="rotulo">{{ rotuloQueixas or (servicos | numeroDe('saude-capilar')) + ' · ' + cap.nome }}</p>
      <h2 class="queixas__titulo" id="queixas-titulo">{{ d.titulo | enfase(d.enfase) | safe }}</h2>
      {%- if not semIntroCapilar %}
      <p class="queixas__lead">{{ d.intro }}</p>
      {%- endif %}
    </div>

    <dl class="queixas__lista">
      {%- for c in d.condicoes %}
      <div class="queixa">
        <dt class="queixa__nome">{{ c.nome }}</dt>
        <dd class="queixa__txt">{{ c.texto }}</dd>
      </div>
      {%- endfor %}
    </dl>
  </div>
</section>
