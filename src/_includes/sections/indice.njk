{#-
  Índice de serviços — como o sumário de uma revista, e não uma grade de
  cards. Vem logo depois da primeira dobra: em um olhar, quem chega vê tudo
  o que a casa faz. As três primeiras categorias de servicos.js levam o selo
  de especialidade; as outras seguem com o mesmo peso visual.
-#}
{%- set t = destaques.indice -%}
<section class="indice{% if indiceTopo %} indice--topo{% endif %}" aria-labelledby="indice-titulo">
  <div class="env">
    <div class="indice__cab">
      <p class="rotulo">Serviços</p>
      <h2 class="indice__titulo" id="indice-titulo">{{ t.titulo | enfase(t.enfase) | safe }}</h2>
      <p class="indice__lead">{{ t.lead }}</p>
    </div>

    <ol class="indice__lista">
      {%- for cat in servicos %}
      <li class="indice__item{% if loop.index <= 3 %} indice__item--destaque{% endif %}">
        <a class="indice__link" href="{{ cat.pagina }}">
          <span class="indice__num" aria-hidden="true">{{ loop.index | dois }}</span>
          <span class="indice__nome">
            {%- if loop.index <= 3 %}<span class="indice__selo">{{ t.selo }}</span> {% endif %}{{ cat.nome -}}
          </span>
          <span class="indice__desc">
            <span class="indice__chamada">{{ cat.chamada }}</span>
            <span class="indice__itens">{{ cat.destaques | join(' · ') }}</span>
          </span>
          <span class="indice__seta" aria-hidden="true">{% icon "seta" %}</span>
        </a>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
