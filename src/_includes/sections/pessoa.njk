{%- import "components/macros.njk" as m -%}
{#-
  Quem atende — uma seção por profissional, com o mesmo desenho para todos:
  retrato na moldura dupla, título, um ou dois parágrafos, ficha e botão.

  Antes de incluir, defina `pessoaId` com a chave de equipe.js (dados) e de
  destaques.js (textos): 'rejane' ou 'gilberto'. Opções:
   • `pessoaInvertida` — retrato à direita (alterna com a seção vizinha);
   • `pessoaCreme` — fundo creme (quando a seção de cima já é clara);
   • `rejaneCompleta` — na seção da Dra. Rejane, mostra também as quatro
     etapas da avaliação (página Sobre e página de saúde capilar);
   • `nivelPessoa` — nível do título (padrão h2).

  Sem link para o Instagram pessoal da Dra. Rejane: as artes de lá trazem o
  telefone pessoal, e o agendamento é um só, pelo WhatsApp da casa.
-#}
{%- set r = equipe[pessoaId] -%}
{%- set t = destaques[pessoaId] -%}
{%- set n = nivelPessoa or 2 -%}
<section class="pessoa{% if pessoaInvertida %} pessoa--invertida{% endif %}{% if pessoaCreme %} pessoa--creme{% endif %}" id="{{ r.ancora }}" aria-labelledby="{{ pessoaId }}-titulo">
  <div class="env pessoa__grade">
    <figure class="pessoa__foto moldura">
      {{ m.foto(r.fotos.principal.imagem, r.fotos.principal.alt, '(min-width: 64rem) 30rem, (min-width: 40rem) 70vw, 92vw') }}
      <figcaption>{{ r.legenda }}</figcaption>
    </figure>

    <div class="pessoa__texto">
      <p class="rotulo">{{ t.rotulo }}</p>
      <h{{ n }} class="pessoa__titulo" id="{{ pessoaId }}-titulo">{{ t.titulo | enfase(t.enfase) | safe }}</h{{ n }}>
      {%- for p in t.paragrafos %}
      <p{% if loop.first %} class="pessoa__lead"{% endif %}>{{ p }}</p>
      {%- endfor %}

      <dl class="pessoa__ficha">
        {%- for linha in r.ficha %}
        <div>
          <dt>{{ linha.rotulo }}</dt>
          <dd>{% if linha.valor is string %}{{ linha.valor }}{% else %}{% for v in linha.valor %}{{ v }}{% if not loop.last %}<br>{% endif %}{% endfor %}{% endif %}</dd>
        </div>
        {%- endfor %}
      </dl>

      <div class="acoes">
        {{ m.wa(business, r.wa, r.cta, 'btn btn--wa') }}
      </div>
    </div>
  </div>

  {%- if rejaneCompleta and r.avaliacao %}
  <div class="env">
    <div class="avaliacao">
      <figure class="avaliacao__foto moldura">
        {{ m.foto(r.fotos.avaliacao.imagem, r.fotos.avaliacao.alt, '(min-width: 64rem) 20rem, (min-width: 40rem) 50vw, 92vw') }}
      </figure>
      <div class="avaliacao__texto">
      <h{{ n + 1 }} class="avaliacao__titulo">{{ t.fraseAvaliacao }}</h{{ n + 1 }}>
      <ol class="avaliacao__passos">
        {%- for passo in r.avaliacao %}
        <li class="avaliacao__passo">
          <span class="avaliacao__num" aria-hidden="true">{{ loop.index | dois }}</span>
          <h{{ n + 2 }} class="avaliacao__nome">{{ passo.nome }}</h{{ n + 2 }}>
          <p>{{ passo.texto }}</p>
        </li>
        {%- endfor %}
      </ol>
      </div>
    </div>
  </div>
  {%- endif %}
</section>
