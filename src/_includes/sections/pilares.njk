{%- import "components/macros.njk" as m -%}
{#-
  As três especialidades que a casa quer em evidência, logo depois da
  primeira dobra. Os outros serviços seguem no índice, mais abaixo, e na
  página de serviços. Textos em destaques.js → pilares; nome, chamada e
  página vêm de servicos.js.
-#}
{%- set p = destaques.pilares -%}
<section class="pilares" aria-labelledby="pilares-titulo">
  <div class="env">
    <div class="pilares__cab">
      <p class="rotulo">Especialidades</p>
      <h2 class="pilares__titulo" id="pilares-titulo">{{ p.titulo | enfase(p.enfase) | safe }}</h2>
      <p class="pilares__intro">{{ p.intro }}</p>
    </div>

    <ol class="pilares__lista">
      {%- for id in ['saude-capilar', 'emagrecimento', 'estetica-avancada'] %}
      {%- set cat = servicos | categoria(id) %}
      <li class="pilar">
        <p class="pilar__num" aria-hidden="true">{{ servicos | numeroDe(id) }}</p>
        <h3 class="pilar__nome"><a href="{{ cat.pagina }}">{{ cat.nome }}</a></h3>
        <p class="pilar__chamada">{{ cat.chamada }}</p>
        <p class="pilar__txt">{{ p.textos[id] }}</p>
        <span class="pilar__seta" aria-hidden="true">{% icon "seta" %}</span>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
